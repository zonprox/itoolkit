<UserControl x:Class="IToolkit.App.Views.IdentityBackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             xmlns:converters="clr-namespace:IToolkit.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:IdentityBackupViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <!-- Header -->
            <TextBlock Text="Identity Administration &amp; Profile Backup" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
            <TextBlock Text="Local user accounts, SID -500 Administrator enablement, domain reachability, and verified Robocopy backup/restore." FontSize="13" Foreground="#AAAAAA" Margin="0,0,0,20"/>

            <!-- Execution Status Banner -->
            <Border Background="#252528" CornerRadius="6" Padding="14" Margin="0,0,0,16" BorderBrush="#3A3A3E" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Current Operation Status" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                        <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}" FontSize="13" FontWeight="Medium" Foreground="#E0E0E0" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsBusy}" Width="120" Height="6" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                </Grid>
            </Border>

            <!-- Card 1: Local User Accounts & SID -500 Admin -->
            <Border Background="#1E1E20" CornerRadius="8" Padding="18" Margin="0,0,0,16" BorderBrush="#2E2E32" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="1. Local Accounts &amp; Built-in Administrator" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <TextBlock Text="Manage local accounts, enable the language-agnostic built-in Administrator (SID -500), and reset passwords." FontSize="12" Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Refresh Accounts" Command="{Binding RefreshAccountsCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#0067C0" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                        <Button Content="Enable Built-in Admin" Command="{Binding EnableBuiltInAdminCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                        <Button Content="Unlock Selected" Command="{Binding UnlockAccountCommand}" IsEnabled="{Binding IsNotBusy}" Padding="12,6" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                        <Button Content="Toggle Enabled" Command="{Binding ToggleAccountEnabledCommand}" IsEnabled="{Binding IsNotBusy}" Padding="12,6" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                        <Button Content="Remove Selected" Command="{Binding RemoveAccountCommand}" IsEnabled="{Binding IsNotBusy}" Padding="12,6" Background="#6B1D1D" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                    </WrapPanel>

                    <!-- Accounts Table -->
                    <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" Height="150" Background="#18181A" Foreground="#FFFFFF" BorderBrush="#3A3A3E" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160"/>
                            <DataGridTextColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="80"/>
                            <DataGridTextColumn Header="Locked" Binding="{Binding IsLocked}" Width="80"/>
                            <DataGridTextColumn Header="Admin" Binding="{Binding IsAdmin}" Width="80"/>
                            <DataGridTextColumn Header="SID" Binding="{Binding Sid}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{Binding LastIdentityStatus, StringFormat='Identity Status: {0}'}" FontSize="12" Foreground="#CCCCCC"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Domain Connectivity -->
            <Border Background="#1E1E20" CornerRadius="8" Padding="18" Margin="0,0,0,16" BorderBrush="#2E2E32" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="2. Zero-RSAT Domain Management" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <TextBlock Text="Verify Active Directory domain reachability across DNS, Kerberos 88, LDAP 389, and SMB 445 ports." FontSize="12" Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Domain Name:" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding DomainTestName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180" Background="#252528" Foreground="#FFFFFF" BorderBrush="#3A3A3E" Padding="6,4" Margin="0,0,12,0"/>
                        <Button Content="Test Domain Reachability" Command="{Binding TestDomainReachabilityCommand}" IsEnabled="{Binding IsNotBusy}" Padding="12,6" Background="#2D2D30" Foreground="#FFFFFF"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: User Profile Backup -->
            <Border Background="#1E1E20" CornerRadius="8" Padding="18" Margin="0,0,0,16" BorderBrush="#2E2E32" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="3. User Profile Backup &amp; Manifest Verification" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <TextBlock Text="Robocopy synchronization, Chrome/Edge bookmarks JSON export, personal PFX certificate export, and SHA-256 manifest." FontSize="12" Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Backup Destination:" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12"/>
                        <TextBox Grid.Column="1" Text="{Binding BackupDestinationDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#252528" Foreground="#FFFFFF" BorderBrush="#3A3A3E" Padding="6,4"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <CheckBox Content="Export Bookmarks" IsChecked="{Binding IncludeBookmarks, Mode=TwoWay}" Foreground="#E0E0E0" Margin="0,0,20,0" FontSize="12"/>
                        <CheckBox Content="Export PFX Certificates" IsChecked="{Binding IncludeCertificates, Mode=TwoWay}" Foreground="#E0E0E0" Margin="0,0,20,0" FontSize="12"/>
                        <CheckBox Content="Mirror Sync (/MIR)" IsChecked="{Binding RobocopyMirror, Mode=TwoWay}" Foreground="#E0E0E0" Margin="0,0,20,0" FontSize="12"/>
                        <CheckBox Content="Create Manifest" IsChecked="{Binding CreateManifest, Mode=TwoWay}" Foreground="#E0E0E0" FontSize="12"/>
                    </StackPanel>

                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Execute Profile Backup" Command="{Binding ExecuteProfileBackupCommand}" IsEnabled="{Binding IsNotBusy}" Padding="16,8" Background="#0067C0" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,10,8"/>
                        <Button Content="Validate Backup Manifest" Command="{Binding ValidateBackupManifestCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                        <Button Content="Restore Profile Data" Command="{Binding RestoreProfileCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                    </WrapPanel>

                    <TextBlock Text="{Binding LastBackupStatus, StringFormat='Backup Status: {0}'}" FontSize="12" Foreground="#CCCCCC"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
