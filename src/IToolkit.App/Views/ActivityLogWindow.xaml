<Window x:Class="IToolkit.App.Views.ActivityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IToolkit.App.Views"
        Title="iToolKit - Activity Log"
        Icon="pack://application:,,,/iToolKit;component/Assets/iToolKit.ico"
        Width="780" Height="460"
        MinWidth="600" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
    <Grid>
        <views:ActivityConsoleView VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
    </Grid>
</Window>
