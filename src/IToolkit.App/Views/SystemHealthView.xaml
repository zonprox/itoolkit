<UserControl x:Class="IToolkit.App.Views.SystemHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             xmlns:converters="clr-namespace:IToolkit.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:SystemHealthViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="10" MaxWidth="1040" HorizontalAlignment="Stretch">
        <!-- Structured 3-Tab Sub-Views -->
        <TabControl Style="{StaticResource FluentTabControlStyle}" Margin="0">
            <!-- Tab 1: Image & File Integrity -->
            <TabItem Header="Image &amp; File Integrity">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,16">
                        <!-- DISM & SFC Execution Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Windows Image &amp; File Integrity (DISM &amp; SFC)" Style="{StaticResource FluentSectionTitleStyle}" />

                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="Run DISM + SFC Combo Repair" Command="{Binding RunDismSfcPipelineCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                            Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="SFC Scan Only" Command="{Binding RunSfcScanCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="DISM RestoreHealth Only" Command="{Binding RunDismRestoreHealthCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="14,7" Margin="0,0,8,6" />
                                </WrapPanel>

                                <UniformGrid Columns="2" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding LastDismStatus, StringFormat='DISM: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                                    <TextBlock Text="{Binding LastSfcStatus, StringFormat='SFC: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Custom WIM Source Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Custom WIM / ESD Source Configuration" Style="{StaticResource FluentSectionTitleStyle}" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Custom WIM Source:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="1" Text="{Binding CustomWimSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseWimSourceCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,5" Margin="0,0,6,0"
                                            ToolTip="Select .wim, .esd, or source folder" />
                                    <Button Grid.Column="3" Content="Open Folder" Command="{Binding OpenWimFolderCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,5"
                                            ToolTip="Open source directory in Explorer" />
                                </Grid>

                                <CheckBox Content="Limit Source Access (/LimitAccess: Prevent contacting Windows Update)"
                                          IsChecked="{Binding LimitSourceAccess, Mode=TwoWay}"
                                          FontSize="12" Margin="0,0,0,6" />

                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0"
                                        Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="System reboot is required to finalize image repairs."
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="12" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Windows Update & WMI Salvage -->
            <TabItem Header="Windows Update &amp; WMI Salvage">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,16">
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,12">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="Windows Update Reset" Style="{StaticResource FluentSectionTitleStyle}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom">
                                        <Button Content="Reset Windows Update" Command="{Binding ResetWindowsUpdateCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                                HorizontalAlignment="Left" Padding="14,7" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding LastWindowsUpdateStatus, StringFormat='Result: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource FluentCardStyle}" Margin="6,0,0,12">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="WMI Repository Salvage" Style="{StaticResource FluentSectionTitleStyle}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom">
                                        <Button Content="Salvage WMI Repository" Command="{Binding RepairWmiCommand}"
                                                IsEnabled="{Binding IsNotBusy}" HorizontalAlignment="Left" Padding="14,7" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding LastWmiStatus, StringFormat='Result: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,12">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="Windows Update Blocker (Windows 10 / 11)" Style="{StaticResource FluentSectionTitleStyle}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom">
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="Block Updates" Command="{Binding BlockWindowsUpdatesCommand}"
                                                    IsEnabled="{Binding IsNotBusy}" Padding="14,7" Margin="0,0,8,0" />
                                            <Button Content="Unblock Updates" Command="{Binding UnblockWindowsUpdatesCommand}"
                                                    IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}" Padding="14,7" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding LastWindowsUpdateBlockStatus, StringFormat='Result: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource FluentCardStyle}" Margin="6,0,0,12">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="Server Time Synchronization (W32Time)" Style="{StaticResource FluentSectionTitleStyle}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom">
                                        <Button Content="Sync Server Time" Command="{Binding SyncSystemTimeCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                                HorizontalAlignment="Left" Padding="14,7" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding LastTimeSyncStatus, StringFormat='Result: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Storage & WinSxS Cleanup -->
            <TabItem Header="Storage &amp; WinSxS Cleanup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,16">
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Unified Storage &amp; WinSxS Component Cleanup" Style="{StaticResource FluentSectionTitleStyle}" />

                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock Text="Temp File Age:" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                                    <ComboBox SelectedValue="{Binding SelectedCleanupThresholdHours, Mode=TwoWay}"
                                              SelectedValuePath="Tag" Width="190" Margin="0,0,20,0">
                                        <ComboBoxItem Content="Older than 24 Hours" Tag="24" IsSelected="True" />
                                        <ComboBoxItem Content="Older than 7 Days" Tag="168" />
                                    </ComboBox>
                                    <CheckBox Content="Deep WinSxS Cleanup (/ResetBase)"
                                              IsChecked="{Binding WinSxSResetBase, Mode=TwoWay}"
                                              VerticalAlignment="Center" FontSize="12" />
                                </WrapPanel>

                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="Run Unified Disk Cleanup" Command="{Binding RunUnifiedDiskCleanupCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                            Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="Run WinSxS Cleanup Only" Command="{Binding CleanWinSxSCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="14,7" Margin="0,0,8,6" />
                                </WrapPanel>

                                <TextBlock Text="{Binding LastCleanupSummary, StringFormat='Summary: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
