<UserControl x:Class="IToolkit.App.Views.ActivityConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             xmlns:models="clr-namespace:IToolkit.Core.Models;assembly=IToolkit.Core"
             xmlns:converters="clr-namespace:IToolkit.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ActivityConsoleViewModel}"
             Height="{Binding ConsoleHeight}"
             MinHeight="36"
             MaxHeight="500"
             Background="#0E0E12"
             Foreground="#E4E4E7"
             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
    <UserControl.Resources>
        <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Console Header Toolbar -->
            <RowDefinition Height="36" />
            <!-- Row 1: Post-Execution Pause Acknowledgment Banner -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Live Log Terminal Stream -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Console Header Toolbar -->
        <Border Grid.Row="0" Background="#141418" BorderBrush="#27272A" BorderThickness="0,1,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Title and Entry Count -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Execution Status Pill -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <!-- Filter Controls -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <!-- Action Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title and Count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M3,4 L21,4 L21,20 L3,20 Z M6,8 L10,12 L6,16 M11,16 L17,16"
                          Stroke="#38BDF8" StrokeThickness="1.8" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="Activity Console" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <Border Background="#202026" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} entries'}" FontSize="10" Foreground="#A1A1AA" />
                    </Border>
                </StackPanel>

                <!-- Left: Execution Status Pill -->
                <Border Grid.Column="1" Background="#202026" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{Binding ExecutionStatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ExecutionStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ExecutionStatusBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Right: Search and Level Filter -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="140" Height="24" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1F1F24" Foreground="#FFFFFF" BorderBrush="#3F3F46" BorderThickness="1"
                             Padding="6,2" FontSize="11" VerticalContentAlignment="Center"
                             ToolTip="Search logs by keyword or component" />
                    
                    <ComboBox Height="24" Width="80" Margin="6,0,0,0" SelectedValue="{Binding SelectedLevelFilter}"
                              SelectedValuePath="Content" Background="#1F1F24" Foreground="#FFFFFF" BorderBrush="#3F3F46" FontSize="11">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="Info" />
                        <ComboBoxItem Content="Success" />
                        <ComboBoxItem Content="Warning" />
                        <ComboBoxItem Content="Error" />
                    </ComboBox>
                </StackPanel>

                <!-- Right: Toolbar Action Buttons -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Auto-Scroll Toggle -->
                    <Primitives:ToggleButton xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                  IsChecked="{Binding AutoScroll}" Height="24" Padding="8,0" Margin="0,0,4,0"
                                  Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" Cursor="Hand" ToolTip="Toggle automatic scroll to bottom">
                        <TextBlock Text="Auto-Scroll" FontSize="11" />
                    </Primitives:ToggleButton>

                    <!-- Copy Log -->
                    <Button Command="{Binding CopyLogCommand}" Height="24" Padding="8,0" Margin="0,0,4,0"
                            Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" Cursor="Hand" ToolTip="Copy all visible logs to clipboard">
                        <TextBlock Text="Copy Log" FontSize="11" />
                    </Button>

                    <!-- Clear Log -->
                    <Button Command="{Binding ClearLogCommand}" Height="24" Padding="8,0" Margin="0,0,4,0"
                            Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" Cursor="Hand" ToolTip="Clear activity log">
                        <TextBlock Text="Clear" FontSize="11" />
                    </Button>

                    <!-- Expand / Collapse -->
                    <Button Command="{Binding ToggleExpandedCommand}" Height="24" Width="26"
                            Background="#27272A" Foreground="#FFFFFF" BorderBrush="#3F3F46" Cursor="Hand" ToolTip="Expand or Collapse console">
                        <Path Data="M4,14 L10,8 L16,14" Stroke="#FFFFFF" StrokeThickness="1.8" Stretch="Uniform" Width="10" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Post-Execution Pause Acknowledgment Banner (Replaces TUI Press Enter to continue) -->
        <Border Grid.Row="1" Background="{Binding CompletionBannerBrush}" Padding="12,6"
                Visibility="{Binding ShowCompletionBanner, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <TextBlock Text="{Binding CompletionMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                <Button Command="{Binding DismissCompletionCommand}" Content="Acknowledge and Dismiss" HorizontalAlignment="Right"
                        Padding="10,2" Background="#1E1E24" Foreground="#FFFFFF" BorderBrush="#FFFFFF" BorderThickness="1"
                        Cursor="Hand" FontSize="11" />
            </Grid>
        </Border>

        <!-- Row 2: Live Log Terminal Stream -->
        <ListBox x:Name="LogListBox" Grid.Row="2" ItemsSource="{Binding FilteredEntries}"
                 Background="#0A0A0D" BorderThickness="0" Padding="8,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ActivityLogEntry}">
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <!-- Timestamp -->
                            <ColumnDefinition Width="80" />
                            <!-- Level Badge -->
                            <ColumnDefinition Width="65" />
                            <!-- Component -->
                            <ColumnDefinition Width="135" />
                            <!-- Message -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Timestamp -->
                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                   FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" />

                        <!-- Level Badge -->
                        <Border Grid.Column="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}, ConverterParameter='Background'}">
                            <TextBlock Text="{Binding Level}" FontSize="9" FontWeight="Bold"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}, ConverterParameter='Foreground'}" />
                        </Border>

                        <!-- Component Tag -->
                        <TextBlock Grid.Column="2" Text="{Binding Component, StringFormat='[{0}]'}"
                                   FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#C084FC"
                                   TextTrimming="CharacterEllipsis" Margin="4,0" VerticalAlignment="Center" />

                        <!-- Message -->
                        <TextBox Grid.Column="3" Text="{Binding Message, Mode=OneWay}"
                                 FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#E4E4E7"
                                 Background="Transparent" BorderThickness="0" IsReadOnly="True"
                                 TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
