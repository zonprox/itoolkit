<UserControl x:Class="IToolkit.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             xmlns:converters="clr-namespace:IToolkit.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <!-- Header -->
            <TextBlock Text="Welcome to iToolKit" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
            <TextBlock Text="Automated Windows 10 &amp; 11 diagnostics, remediation, and optimization workstation." FontSize="13" Foreground="#AAAAAA" Margin="0,0,0,20"/>

            <!-- Execution Status Banner -->
            <Border Background="#252528" CornerRadius="6" Padding="14" Margin="0,0,0,16" BorderBrush="#3A3A3E" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Current Operation Status" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                        <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}" FontSize="13" FontWeight="Medium" Foreground="#E0E0E0" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsBusy}" Width="120" Height="6" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                </Grid>
            </Border>

            <!-- Quick Action Cards Section -->
            <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
            <UniformGrid Columns="3" Margin="0,0,0,24">
                <!-- Card 1: System Repair -->
                <Border Background="#1E1E20" CornerRadius="8" Padding="16" Margin="0,0,12,12" BorderBrush="#2E2E32" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="System Health" FontSize="14" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                        <TextBlock Text="DISM + SFC Image &amp; File Integrity check" FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="Run System Repair" Command="{Binding QuickSystemRepairCommand}" IsEnabled="{Binding IsNotBusy}" Background="#0067C0" Foreground="#FFFFFF" Padding="12,6"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Outlook Repair -->
                <Border Background="#1E1E20" CornerRadius="8" Padding="16" Margin="0,0,12,12" BorderBrush="#2E2E32" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Office &amp; Outlook" FontSize="14" FontWeight="SemiBold" Foreground="#4ADE80" Margin="0,0,0,4"/>
                        <TextBlock Text="Purge stuck Outbox, SRS, and RoamCache" FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="Quick Mail Repair" Command="{Binding QuickMailRepairCommand}" IsEnabled="{Binding IsNotBusy}" Background="#2D2D30" Foreground="#FFFFFF" Padding="12,6"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Network Remediation -->
                <Border Background="#1E1E20" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#2E2E32" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Network Stack" FontSize="14" FontWeight="SemiBold" Foreground="#FBBF24" Margin="0,0,0,4"/>
                        <TextBlock Text="Flush DNS, DHCP renewal, Winsock &amp; TCP/IP reset" FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="Reset Network" Command="{Binding QuickNetworkResetCommand}" IsEnabled="{Binding IsNotBusy}" Background="#2D2D30" Foreground="#FFFFFF" Padding="12,6"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Unified Cleanup -->
                <Border Background="#1E1E20" CornerRadius="8" Padding="16" Margin="0,0,12,0" BorderBrush="#2E2E32" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Disk Cleanup" FontSize="14" FontWeight="SemiBold" Foreground="#C084FC" Margin="0,0,0,4"/>
                        <TextBlock Text="Purge temporary files, update &amp; delivery caches" FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="Run Disk Cleanup" Command="{Binding QuickDiskCleanupCommand}" IsEnabled="{Binding IsNotBusy}" Background="#2D2D30" Foreground="#FFFFFF" Padding="12,6"/>
                    </StackPanel>
                </Border>

                <!-- Card 5: Software Upgrade -->
                <Border Background="#1E1E20" CornerRadius="8" Padding="16" Margin="0,0,12,0" BorderBrush="#2E2E32" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Software Packages" FontSize="14" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                        <TextBlock Text="Upgrade all installed Winget applications" FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="Upgrade All Apps" Command="{Binding QuickSoftwareUpgradeCommand}" IsEnabled="{Binding IsNotBusy}" Background="#2D2D30" Foreground="#FFFFFF" Padding="12,6"/>
                    </StackPanel>
                </Border>

                <!-- Card 6: Profile Backup -->
                <Border Background="#1E1E20" CornerRadius="8" Padding="16" Margin="0,0,0,0" BorderBrush="#2E2E32" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Identity &amp; Backup" FontSize="14" FontWeight="SemiBold" Foreground="#4ADE80" Margin="0,0,0,4"/>
                        <TextBlock Text="Robocopy profile backup with SHA-256 manifest" FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="Quick Backup" Command="{Binding QuickProfileBackupCommand}" IsEnabled="{Binding IsNotBusy}" Background="#2D2D30" Foreground="#FFFFFF" Padding="12,6"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Pillar Navigation Guide Card -->
            <Border Background="#18181B" CornerRadius="8" Padding="18" BorderBrush="#27272A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Explore the 5 Operational Pillars" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                    <TextBlock Text="Use the left navigation rail to access deep configuration controls, granular logs, and specialized maintenance tools for each subsystem." FontSize="12" Foreground="#888888" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
