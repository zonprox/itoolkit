<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NETSDK1188;CA1416</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <Target Name="FilterNonEnglishSatelliteResources" BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.DestinationSubDirectory)' != '' and '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' != 'en\' and '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' != 'en/'" />
    </ItemGroup>
  </Target>

  <Target Name="FilterNonEnglishPublishFiles" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.DestinationSubDirectory)' != '' and '%(ResolvedFileToPublish.DestinationSubDirectory)' != 'en\' and '%(ResolvedFileToPublish.DestinationSubDirectory)' != 'en/'" />
    </ItemGroup>
  </Target>

  <Target Name="PurgeNonEnglishSatelliteDirectories" AfterTargets="Build;Publish">
    <ItemGroup>
      <NonEnglishDirs Include="$(TargetDir)cs;$(TargetDir)de;$(TargetDir)es;$(TargetDir)fr;$(TargetDir)it;$(TargetDir)ja;$(TargetDir)ko;$(TargetDir)pl;$(TargetDir)pt-BR;$(TargetDir)ru;$(TargetDir)tr;$(TargetDir)zh-Hans;$(TargetDir)zh-Hant" />
      <NonEnglishPublishDirs Include="$(PublishDir)cs;$(PublishDir)de;$(PublishDir)es;$(PublishDir)fr;$(PublishDir)it;$(PublishDir)ja;$(PublishDir)ko;$(PublishDir)pl;$(PublishDir)pt-BR;$(PublishDir)ru;$(PublishDir)tr;$(PublishDir)zh-Hans;$(PublishDir)zh-Hant" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <RemoveDir Directories="@(NonEnglishDirs)" />
    <RemoveDir Directories="@(NonEnglishPublishDirs)" />
  </Target>

</Project>
