<UserControl x:Class="IToolkit.App.Views.TelemetryHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TelemetryHeaderViewModel}"
             Background="#18181B"
             Foreground="#F4F4F5"
             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
    <Border BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="16,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- OS Build & Elevation -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <!-- CPU Metric -->
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="16" />
                <!-- RAM Metric -->
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="16" />
                <!-- Disk C: Health Metric -->
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <!-- Network & Task Status -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <!-- Refresh Button -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: OS Build & Elevation Badge -->
            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M2,2 L10,2 L10,10 L2,10 Z M12,2 L20,2 L20,10 L12,10 Z M2,12 L10,12 L10,20 L2,20 Z M12,12 L20,12 L20,20 L12,20 Z"
                          Fill="#38BDF8" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OsDescription}" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="{Binding OsBuild}" FontSize="11" Foreground="#A1A1AA" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Border CornerRadius="4" Padding="6,1" Background="{Binding ElevationBadgeBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ElevationBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Column 2: CPU Metric Card -->
            <Border Grid.Column="2" Background="#202024" CornerRadius="6" Padding="10,6" BorderBrush="#2E2E33" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <Grid>
                        <TextBlock Text="CPU Load" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding CpuUsageText}" FontSize="11" FontWeight="Bold" Foreground="{Binding CpuBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Height="5" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="{Binding CpuUsagePercentage}"
                                 Foreground="{Binding CpuBrush}" Background="#2E2E33" BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- Column 4: RAM Metric Card -->
            <Border Grid.Column="4" Background="#202024" CornerRadius="6" Padding="10,6" BorderBrush="#2E2E33" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <Grid>
                        <TextBlock Text="Memory Usage" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding MemoryPercentageText}" FontSize="11" FontWeight="Bold" Foreground="{Binding MemoryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Height="5" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="{Binding MemoryPercentage}"
                                 Foreground="{Binding MemoryBrush}" Background="#2E2E33" BorderThickness="0" />
                    <TextBlock Text="{Binding MemoryUsageText}" FontSize="9" Foreground="#71717A" Margin="0,2,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>

            <!-- Column 6: Disk C: Health Card -->
            <Border Grid.Column="6" Background="#202024" CornerRadius="6" Padding="10,6" BorderBrush="#2E2E33" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="Drive C: " FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA" />
                            <TextBlock Text="{Binding DiskHealthStatus}" FontSize="10" FontWeight="Bold" Foreground="{Binding DiskHealthBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DiskFreeSpaceText}" FontSize="10" Foreground="#E4E4E7" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Height="5" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="{Binding DiskFreePercentage}"
                                 Foreground="{Binding DiskHealthBrush}" Background="#2E2E33" BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- Column 8: Network & Active Task Indicator -->
            <StackPanel Grid.Column="8" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right">
                <!-- Network status -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="7" Height="7" Fill="{Binding NetworkStatusBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NetworkStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding NetworkStatusBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Active task pill -->
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="Task: " FontSize="10" Foreground="#71717A" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveTaskDescription}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Column 10: Refresh Action Button -->
            <Button Grid.Column="10" Command="{Binding RefreshCommand}" ToolTip="Refresh System Telemetry"
                    Width="30" Height="30" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1"
                    Foreground="#FFFFFF" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <Path Data="M17.6,6.4 C16.2,4.9 14.2,4 12,4 C7.6,4 4,7.6 4,12 C4,16.4 7.6,20 12,20 C15.7,20 18.8,17.4 19.7,14 L17.6,14 C16.8,16.3 14.6,18 12,18 C8.7,18 6,15.3 6,12 C6,8.7 8.7,6 12,6 C13.7,6 15.1,6.7 16.2,7.8 L13,11 L20,11 L20,4 L17.6,6.4 Z"
                                  Fill="#E4E4E7" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
