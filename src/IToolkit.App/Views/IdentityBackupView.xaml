<UserControl x:Class="IToolkit.App.Views.IdentityBackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             xmlns:converters="clr-namespace:IToolkit.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:IdentityBackupViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="10" MaxWidth="1040" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status Banner -->
        <Border Grid.Row="0" Style="{StaticResource FluentStatusBannerStyle}" Padding="8,4" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status:" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsBusy}" Width="140" Height="4"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />
            </Grid>
        </Border>

        <!-- Structured 3-Tab Sub-Views -->
        <TabControl Grid.Row="1" Style="{StaticResource FluentTabControlStyle}" Margin="0">
            <!-- Tab 1: Local Accounts & Built-in Admin -->
            <TabItem Header="Local Accounts &amp; Built-in Admin">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,16">
                        <!-- Built-in Administrator Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Built-in Administrator (SID -500)" Style="{StaticResource FluentSectionTitleStyle}" />
                                <TextBlock Text="Enable the built-in Administrator regardless of localized account name and reset its password."
                                           Style="{StaticResource FluentSectionDescriptionStyle}" />

                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="Enable Built-in Admin" Command="{Binding EnableBuiltInAdminCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                            Padding="14,7" Margin="0,0,12,6" />
                                    <TextBlock Text="{Binding BuiltInAdminName, StringFormat='Account: {0}'}"
                                               VerticalAlignment="Center" FontWeight="Medium" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,6" />
                                </WrapPanel>

                                <!-- Reset Admin Password Row -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="New Admin Password:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="1" Text="{Binding NewAdminPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Reset Admin Password" Command="{Binding ResetAdminPasswordCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="14,6" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Local Account Creation Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Create Local User Account" Style="{StaticResource FluentSectionTitleStyle}" />
                                <TextBlock Text="Create a new local standard user or administrator account with specified credentials."
                                           Style="{StaticResource FluentSectionDescriptionStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Username -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,12,0" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewAccountUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="0,0,16,0" />

                                    <!-- Password -->
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Password:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,12,0" />
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding NewAccountPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" />

                                    <!-- Description -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Description / Full Name:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,12,0" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                             Text="{Binding NewAccountDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" />

                                    <!-- Admin Privilege CheckBox & Create Button -->
                                    <CheckBox Grid.Row="4" Grid.Column="1" Content="Grant Administrator Privileges (Administrators Group)"
                                              IsChecked="{Binding NewAccountIsAdmin, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12" />
                                    <Button Grid.Row="4" Grid.Column="3" Content="Create Local Account" Command="{Binding CreateAccountCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                            HorizontalAlignment="Right" Padding="16,6" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Local Accounts DataGrid Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Local Accounts Directory" Style="{StaticResource FluentSectionTitleStyle}" />
                                <TextBlock Text="Inspect discovered accounts, unlock locked credentials, toggle enabled status, or remove accounts."
                                           Style="{StaticResource FluentSectionDescriptionStyle}" />

                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Unlock Selected" Command="{Binding UnlockAccountCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,8,6" />
                                    <Button Content="Toggle Enabled" Command="{Binding ToggleAccountEnabledCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,8,6" />
                                    <Button Content="Remove Selected" Command="{Binding RemoveAccountCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,8,6" />
                                    <Button Content="Refresh Accounts" Command="{Binding RefreshAccountsCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,8,6" />
                                </WrapPanel>

                                <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" Height="160" Margin="0,0,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="180" />
                                        <DataGridTextColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="90" />
                                        <DataGridTextColumn Header="Locked" Binding="{Binding IsLocked}" Width="90" />
                                        <DataGridTextColumn Header="Admin" Binding="{Binding IsAdmin}" Width="90" />
                                        <DataGridTextColumn Header="SID" Binding="{Binding Sid}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="{Binding LastIdentityStatus, StringFormat='Identity Status: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Active Directory Domain Reachability -->
            <TabItem Header="Active Directory Domain Reachability">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,16">
                        <!-- AD Reachability Diagnostic Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Zero-RSAT Active Directory Domain Reachability" Style="{StaticResource FluentSectionTitleStyle}" />
                                <TextBlock Text="Test DNS SRV resolution and TCP connectivity across Kerberos (88), LDAP (389), and SMB (445) ports without RSAT."
                                           Style="{StaticResource FluentSectionDescriptionStyle}" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Domain / Workgroup:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="1" Text="{Binding DomainTestName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Test Reachability" Command="{Binding TestDomainReachabilityCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Domain User Unlock Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Domain User Account Unlock" Style="{StaticResource FluentSectionTitleStyle}" />
                                <TextBlock Text="Unlock a locked domain account on the target domain controller."
                                           Style="{StaticResource FluentSectionDescriptionStyle}" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Domain User SAM Name:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="1" Text="{Binding DomainUserSamName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Unlock Domain User" Command="{Binding UnlockDomainUserCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="16,6" />
                                </Grid>

                                <TextBlock Text="{Binding LastIdentityStatus, StringFormat='Diagnostics: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: User Profile Backup & Restore -->
            <TabItem Header="User Profile Backup &amp; Restore">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,16">
                        <!-- Profile Backup Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="User Profile Backup &amp; SHA-256 Manifest" Style="{StaticResource FluentSectionTitleStyle}" />
                                <TextBlock Text="Synchronize user shell folders via multi-threaded Robocopy, export Chrome/Edge bookmarks and PFX certificates, and generate SHA-256 manifest."
                                           Style="{StaticResource FluentSectionDescriptionStyle}" />

                                <!-- Backup Destination Row -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Backup Destination:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="1" Text="{Binding BackupDestinationDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseBackupDestinationCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,5" Margin="0,0,6,0"
                                            ToolTip="Select backup destination folder" />
                                    <Button Grid.Column="3" Content="Open Folder" Command="{Binding OpenBackupDestinationCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,5"
                                            ToolTip="Open backup destination in Explorer" />
                                </Grid>

                                <WrapPanel Margin="0,0,0,14">
                                    <CheckBox Content="Export Browser Bookmarks" IsChecked="{Binding IncludeBookmarks, Mode=TwoWay}"
                                              Margin="0,0,20,6" FontSize="12" />
                                    <CheckBox Content="Export Personal Certificates (PFX)" IsChecked="{Binding IncludeCertificates, Mode=TwoWay}"
                                              Margin="0,0,20,6" FontSize="12" />
                                    <CheckBox Content="Mirror Sync (/MIR: purge destination differences)" IsChecked="{Binding RobocopyMirror, Mode=TwoWay}"
                                              Margin="0,0,20,6" FontSize="12" />
                                    <CheckBox Content="Generate SHA-256 Manifest" IsChecked="{Binding CreateManifest, Mode=TwoWay}"
                                              Margin="0,0,0,6" FontSize="12" />
                                </WrapPanel>

                                <Button Content="Execute Profile Backup" Command="{Binding ExecuteProfileBackupCommand}"
                                        IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                        HorizontalAlignment="Left" Padding="16,8" Margin="0,0,0,8" />

                                <TextBlock Text="{Binding LastBackupStatus, StringFormat='Backup Status: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Profile Restore Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Profile Restore &amp; Manifest Verification" Style="{StaticResource FluentSectionTitleStyle}" />
                                <TextBlock Text="Verify SHA-256 integrity manifest and restore backed up user shell folders to the active profile."
                                           Style="{StaticResource FluentSectionDescriptionStyle}" />

                                <!-- Restore Destination Row -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Restore Source Folder:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="1" Text="{Binding RestoreBackupDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseRestoreBackupCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,5" Margin="0,0,6,0"
                                            ToolTip="Select restore source folder" />
                                    <Button Grid.Column="3" Content="Open Folder" Command="{Binding OpenRestoreBackupCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,5"
                                            ToolTip="Open restore folder in Explorer" />
                                </Grid>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Validate Backup Manifest" Command="{Binding ValidateBackupManifestCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="Restore Profile Data" Command="{Binding RestoreProfileCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                            Padding="14,7" Margin="0,0,8,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
