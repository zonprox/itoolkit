<UserControl x:Class="IToolkit.App.Views.SoftwareOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             xmlns:converters="clr-namespace:IToolkit.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:SoftwareOptimizationViewModel}"
             mc:Ignorable="d"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Structured 3-Tab Sub-Views -->
        <TabControl Style="{StaticResource FluentTabControlStyle}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Tab 1: Enterprise 8-App Catalog -->
            <TabItem Header="Enterprise 8-App Catalog">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <StackPanel Margin="0,8,0,16">
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Enterprise Application Catalog (8 Apps)" Style="{StaticResource FluentSectionTitleStyle}" />

                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,12">
                                    <Button Content="Select All" Command="{Binding SelectAllCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,8,6" />
                                    <Button Content="Deselect All" Command="{Binding DeselectAllCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,8,6" />
                                    <Button Content="Install Selected Apps" Command="{Binding BatchInstallCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                            Padding="14,6" Margin="0,0,16,6" />
                                    <CheckBox Content="Create Desktop Shortcuts"
                                              IsChecked="{Binding CreateDesktopShortcutsOnInstall, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,0,6" FontSize="12" />
                                </WrapPanel>

                                <ItemsControl ItemsSource="{Binding CatalogApps}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Item.DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Install" Command="{Binding InstallCommand}"
                                                            Padding="12,5" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding LastSoftwareStatus, StringFormat='Catalog Status: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Default App Associations & Winget Subsystem -->
            <TabItem Header="Default App Associations &amp; Winget Subsystem">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <StackPanel Margin="0,8,0,16">
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="Default App Associations &amp; Browser Policy" Style="{StaticResource FluentSectionTitleStyle}" />
                                    <WrapPanel>
                                        <Button Content="Default Browser (Chrome)" Command="{Binding SetDefaultBrowserCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,6,6" />
                                        <Button Content="Default PDF (Foxit)" Command="{Binding SetDefaultPdfViewerCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,6,6" />
                                        <Button Content="uBlock Policy" Command="{Binding ConfigureUblockPolicyCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FluentCardStyle}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Windows Package Manager (Winget)" Style="{StaticResource FluentSectionTitleStyle}" />
                                    <TextBlock Text="{Binding WingetVersionText, StringFormat='Status: {0}'}"
                                               Style="{StaticResource FluentCaptionStyle}" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <Button Content="Check Status" Command="{Binding CheckWingetStatusCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,6,6" />
                                        <Button Content="Upgrade All" Command="{Binding UpgradeAllPackagesCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                                Padding="12,6" Margin="0,0,6,6" />
                                        <Button Content="Repair Sources" Command="{Binding RepairWingetCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Verified Debloat & Tweaking Suites -->
            <TabItem Header="Verified Debloat &amp; Tweaking Suites">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <StackPanel Margin="0,8,0,16">
                        <!-- Community Tools Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Verified Community Debloat &amp; Tweaking Suites" Style="{StaticResource FluentSectionTitleStyle}" />

                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Launch Win11Debloat" Command="{Binding LaunchWin11DebloatCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="Launch BrowserDebloat" Command="{Binding LaunchBrowserDebloatCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="Launch Chris Titus WinUtil" Command="{Binding LaunchChrisTitusWinUtilCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="Launch Sophia Script" Command="{Binding LaunchSophiaScriptCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="14,7" Margin="0,0,8,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Custom HTTPS Script Runner Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Custom HTTPS Debloat Script Runner" Style="{StaticResource FluentSectionTitleStyle}" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Script HTTPS URL:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="1" Text="{Binding CustomDebloatScriptUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Execute Custom Script" Command="{Binding ExecuteCustomDebloatCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" />
                                </Grid>

                                <TextBlock Text="{Binding LastSoftwareStatus, StringFormat='Status: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
