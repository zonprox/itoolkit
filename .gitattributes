# Auto detect text files and perform line normalization
* text=auto

# C# & .NET WPF Source and Project Files
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.manifest text eol=lf

# Shell scripts
*.sh text eol=lf

# Documentation and configuration
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
