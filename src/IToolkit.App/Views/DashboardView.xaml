<UserControl x:Class="IToolkit.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             xmlns:converters="clr-namespace:IToolkit.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">
        <StackPanel Margin="10" HorizontalAlignment="Stretch">

            <!-- Tier 1: System Specifications & Identity Overview Card -->
            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,6">
                <DockPanel LastChildFill="True">
                    <!-- Right: Network Status, Active Task & Refresh -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding NetworkStatusBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NetworkStatusText}" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <Border CornerRadius="3" Padding="6,2"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ActiveTaskDescription}" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       ToolTip="{Binding ActiveTaskDescription}" />
                        </Border>

                        <Button Content="Refresh"
                                Command="{Binding RefreshTelemetryCommand}"
                                Style="{StaticResource FluentButtonStyle}"
                                Padding="8,3" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Left: OS Description, Build, and Elevation Badge -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding OsDescription}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding OsBuild}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border CornerRadius="3" Padding="6,2" Background="{Binding ElevationBadgeBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElevationBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tier 2: Real-Time Hardware Telemetry Metrics -->
            <UniformGrid Columns="3" Margin="0,0,0,6">
                <!-- Metric Card 1: Processor (CPU) -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Processor (CPU)" Style="{StaticResource FluentSectionTitleStyle}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CpuUsageText}" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuUsagePercentage}"
                                     Height="5" Margin="0,0,0,4" Foreground="{Binding CpuBrush}" />
                        <TextBlock Text="{Binding CpuModelName}" Style="{StaticResource FluentCaptionStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CpuModelName}" />
                    </StackPanel>
                </Border>

                <!-- Metric Card 2: Memory (RAM) -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Memory (RAM)" Style="{StaticResource FluentSectionTitleStyle}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryPercentageText}" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding MemoryPercentage}"
                                     Height="5" Margin="0,0,0,4" Foreground="{Binding MemoryBrush}" />
                        <TextBlock Text="{Binding MemoryUsageText}" Style="{StaticResource FluentCaptionStyle}" />
                    </StackPanel>
                </Border>

                <!-- Metric Card 3: Storage (C:) -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="System Storage (C:)" Style="{StaticResource FluentSectionTitleStyle}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DiskHealthStatus}" FontWeight="Bold" FontSize="13"
                                       Foreground="{Binding DiskHealthBrush}" />
                        </DockPanel>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding DiskFreePercentage}"
                                     Height="5" Margin="0,0,0,4" Foreground="{Binding DiskHealthBrush}" />
                        <TextBlock Text="{Binding DiskFreeSpaceText}" Style="{StaticResource FluentCaptionStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tier 2.5: Detailed System Configuration, Host/Domain/User Identity & Active Network -->
            <UniformGrid Columns="3" Margin="0,0,0,6">
                <!-- Spec Card 1: Host, Domain & User Identity -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Host, Domain &amp; User Identity" Style="{StaticResource FluentSectionTitleStyle}" Margin="0,0,0,4" />
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="Computer Name:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ComputerName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ComputerName}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="Domain / Workgroup:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DomainOrWorkgroup}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DomainOrWorkgroup}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="Current User:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CurrentUser}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentUser}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="User Profile:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding UserProfilePath}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding UserProfilePath}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="Arch / Uptime:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding OsArchitecture}" />
                                <Run Text=" | Up: " />
                                <Run Text="{Binding SystemUptime}" />
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Spec Card 2: Hardware, BIOS & Drives Summary -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Hardware &amp; Storage Inventory" Style="{StaticResource FluentSectionTitleStyle}" Margin="0,0,0,4" />
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="System Model:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SystemManufacturerModel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SystemManufacturerModel}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="CPU Model:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CpuModelName}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CpuModelName}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="Graphics (GPU):" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding GpuModelName}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GpuModelName}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="BIOS / Serial:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding BiosAndSerial}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BiosAndSerial}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="Fixed Drives:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding AllDrivesSummary}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AllDrivesSummary}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Spec Card 3: Active Network & IP Configuration -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Active Network Configuration" Style="{StaticResource FluentSectionTitleStyle}" Margin="0,0,0,4" />
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="Adapter:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding PrimaryNetworkAdapter}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PrimaryNetworkAdapter}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="IPv4 Address:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Ipv4Address}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Ipv4Address}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="Gateway:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DefaultGateway}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DefaultGateway}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="DNS Servers:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DnsServers}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DnsServers}" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="MAC Address:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding MacAddress}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MacAddress}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tier 3: Section Divider Header -->
            <TextBlock Text="Quick Actions" Style="{StaticResource FluentSectionTitleStyle}" Margin="0,2,0,4" />

            <!-- Tier 3: Quick Actions Grid (All 6 Existing Cards Preserved) -->
            <UniformGrid Columns="3" Margin="0,0,0,8">
                <!-- Card 1: System Integrity Repair -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="System Integrity Repair" Style="{StaticResource FluentSectionTitleStyle}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="{Binding SystemHealthStatus}" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,0,8" />
                            <Button Content="Run System Repair"
                                    Command="{Binding QuickSystemRepairCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" Padding="10,5" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Card 2: Outlook & Mail Repair -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Outlook &amp; Mail Repair" Style="{StaticResource FluentSectionTitleStyle}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="{Binding OfficeStatus}" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,0,8" />
                            <Button Content="Quick Mail Repair"
                                    Command="{Binding QuickMailRepairCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    HorizontalAlignment="Left" Padding="10,5" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Card 3: Network Stack Reset -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Network Stack Reset" Style="{StaticResource FluentSectionTitleStyle}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="{Binding NetworkStatus}" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,0,8" />
                            <Button Content="Reset Network Stack"
                                    Command="{Binding QuickNetworkResetCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    HorizontalAlignment="Left" Padding="10,5" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Card 4: Storage Cleanup -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Unified Storage Cleanup" Style="{StaticResource FluentSectionTitleStyle}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="{Binding SystemHealthStatus}" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,0,8" />
                            <Button Content="Run Storage Cleanup"
                                    Command="{Binding QuickDiskCleanupCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    HorizontalAlignment="Left" Padding="10,5" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Card 5: Software Updates -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Upgrade All Applications" Style="{StaticResource FluentSectionTitleStyle}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="{Binding SoftwareStatus}" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,0,8" />
                            <Button Content="Upgrade All Apps"
                                    Command="{Binding QuickSoftwareUpgradeCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    HorizontalAlignment="Left" Padding="10,5" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Card 6: Profile Backup -->
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Verified Profile Backup" Style="{StaticResource FluentSectionTitleStyle}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="{Binding BackupStatus}" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,0,8" />
                            <Button Content="Quick Profile Backup"
                                    Command="{Binding QuickProfileBackupCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    HorizontalAlignment="Left" Padding="10,5" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
