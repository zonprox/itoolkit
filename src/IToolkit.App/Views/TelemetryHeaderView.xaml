<UserControl x:Class="IToolkit.App.Views.TelemetryHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TelemetryHeaderViewModel}">

    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,3"
            ClipToBounds="True">
        <DockPanel LastChildFill="True" ClipToBounds="True">
            <!-- Right: Network Status and Active Task Description -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{Binding NetworkStatusBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding NetworkStatusText}" FontSize="11" FontWeight="Medium"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Border CornerRadius="3" Padding="5,1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveTaskDescription}" FontSize="10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="105"
                               ToolTip="{Binding ActiveTaskDescription}" />
                </Border>
            </StackPanel>

            <!-- Left: OS, Build, Elevation, and Inline Metrics -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <!-- OS and Build -->
                <TextBlock Text="{Binding OsDescription}" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"
                           MaxWidth="100" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding OsDescription}" />
                <TextBlock Text="{Binding OsBuild}" FontSize="10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"
                           MaxWidth="75" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding OsBuild}" />

                <!-- Elevation Badge -->
                <Border CornerRadius="3" Padding="4,1" Background="{Binding ElevationBadgeBrush}" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="{Binding ElevationBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" />
                </Border>

                <!-- Separator -->
                <Rectangle Width="1" Height="12" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />

                <!-- CPU Metric Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="CPU:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,2,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CpuUsageText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <ProgressBar Width="24" Height="3" Margin="4,0,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding CpuUsagePercentage}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Memory Metric Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="RAM:" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,2,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MemoryUsageText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"
                               MaxWidth="60" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding MemoryUsageText}" />
                    <ProgressBar Width="24" Height="3" Margin="4,0,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding MemoryPercentage}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Disk Metric Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="C:\" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,2,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DiskFreeSpaceText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"
                               MaxWidth="65" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DiskFreeSpaceText}" />
                    <ProgressBar Width="24" Height="3" Margin="4,0,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding DiskFreePercentage}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
