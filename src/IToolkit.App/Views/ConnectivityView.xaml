<UserControl x:Class="IToolkit.App.Views.ConnectivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             xmlns:converters="clr-namespace:IToolkit.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:ConnectivityViewModel}"
             mc:Ignorable="d"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Structured 3-Tab Sub-Views -->
        <TabControl Style="{StaticResource FluentTabControlStyle}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Tab 1: Network Stack & Adapter Control -->
            <TabItem Header="Network Stack &amp; Adapter Control">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <StackPanel Margin="0,8,0,16">
                        <!-- Network Stack Remediation Card (Global System Operations) -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Network Stack Remediation" Style="{StaticResource FluentSectionTitleStyle}" />

                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="Remediate Full Network Stack" Command="{Binding RemediateNetworkStackCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                            Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="Flush DNS" Command="{Binding FlushDnsCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,7" Margin="0,0,8,6" />
                                    <Button Content="Renew DHCP" Command="{Binding RenewDhcpCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,7" Margin="0,0,8,6" />
                                    <Button Content="Clear ARP" Command="{Binding ClearArpCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,7" Margin="0,0,8,6" />
                                    <Button Content="Reset Winsock" Command="{Binding ResetWinsockCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,7" Margin="0,0,8,6" />
                                    <Button Content="Reset TCP/IP" Command="{Binding ResetTcpIpCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,7" Margin="0,0,8,6" />
                                </WrapPanel>

                                <TextBlock Text="{Binding LastNetworkStatus, StringFormat='Network Status: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Network Adapters Inventory & Per-Adapter Management Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Network Adapters Inventory" Style="{StaticResource FluentSectionTitleStyle}" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Active Adapter:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,0,12,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableAdapters}"
                                              SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}"
                                              DisplayMemberPath="Name" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Refresh Adapters" Command="{Binding RefreshAdaptersCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,5" Margin="0,0,6,0" />
                                    <Button Grid.Column="3" Content="Restart Adapter" Command="{Binding RestartAdapterCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="12,5" Margin="0,0,6,0" />
                                    <Button Grid.Column="4" Content="Manage Adapter" Command="{Binding OpenAdapterEditPopupCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}" Padding="12,5" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Adapter Name:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding NetworkAdapterName}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,16,0" />
                                    <TextBlock Text="Status:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SelectedAdapter.Status, FallbackValue='N/A'}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,16,0" />
                                    <TextBlock Text="Description:" Style="{StaticResource FluentCaptionStyle}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SelectedAdapter.Description, FallbackValue='N/A'}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Network Adapters DataGrid with Per-Adapter Manage Button -->
                                <DataGrid ItemsSource="{Binding AvailableAdapters}" SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="180" Margin="0,0,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Adapter Name" Binding="{Binding Name}" Width="150" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                                        <DataGridTextColumn Header="DHCP" Binding="{Binding DhcpEnabled}" Width="60" />
                                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddresses[0]}" Width="120" />
                                        <DataGridTextColumn Header="Subnet Mask" Binding="{Binding SubnetMask}" Width="120" />
                                        <DataGridTextColumn Header="Gateway" Binding="{Binding DefaultGateway}" Width="120" />
                                        <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="140" />
                                        <DataGridTemplateColumn Header="Manage" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Manage"
                                                            Command="{Binding DataContext.OpenAdapterEditPopupForItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,4" Margin="2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: SMB & Print Spooler Subsystem -->
            <TabItem Header="SMB &amp; Print Spooler Subsystem">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <StackPanel Margin="0,8,0,16">
                        <!-- Global Spooler Subsystem and SMB Sharing Cards -->
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,6,12">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="SMB Sharing &amp; Guest Authentication" Style="{StaticResource FluentSectionTitleStyle}" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Bottom" Content="Configure SMB &amp; Guest Auth"
                                            Command="{Binding ConfigureSmbSharingCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                            HorizontalAlignment="Left" Padding="14,7" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource FluentCardStyle}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Print Spooler Subsystem" Style="{StaticResource FluentSectionTitleStyle}" />
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="Purge Queue" Command="{Binding PurgeSpoolerCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                                Padding="12,6" Margin="0,0,6,6" />
                                        <Button Content="Re-Register DLLs" Command="{Binding RegisterSpoolerCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,6,6" />
                                        <Button Content="Reset NeXX: Ports" Command="{Binding ResetNePortsCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Padding="12,6" Margin="0,0,6,6" />
                                        <Button Content="Refresh Connections" Command="{Binding RefreshPrinterConnectionsCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Padding="12,5" Margin="0,0,6,6" />
                                        <Button Content="Inspect Queue" Command="{Binding InspectSpoolerStatusCommand}"
                                                IsEnabled="{Binding IsNotBusy}" Padding="12,5" Margin="0,0,6,6" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding LastPrinterStatus, StringFormat='Spooler: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Installed Printers Inventory & Management Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Installed Printers Inventory" Style="{StaticResource FluentSectionTitleStyle}" />

                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="Refresh Printers" Command="{Binding RefreshPrintersCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Padding="14,6" Margin="0,0,8,6" />
                                    <Button Content="Manage Selected Printer" Command="{Binding OpenPrinterEditPopupCommand}"
                                            IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                            Padding="14,6" Margin="0,0,8,6" />
                                </WrapPanel>

                                <!-- Installed Printers DataGrid with Per-Printer Manage Button -->
                                <DataGrid ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="180" Margin="0,0,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Printer Name" Binding="{Binding Name}" Width="200" />
                                        <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="180" />
                                        <DataGridTextColumn Header="Port" Binding="{Binding PortName}" Width="90" />
                                        <DataGridTextColumn Header="Default" Binding="{Binding IsDefault}" Width="65" />
                                        <DataGridTextColumn Header="Network" Binding="{Binding IsNetwork}" Width="65" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                                        <DataGridTextColumn Header="Pending Jobs" Binding="{Binding PendingJobCount}" Width="90" />
                                        <DataGridTemplateColumn Header="Manage" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Manage"
                                                            Command="{Binding DataContext.OpenPrinterEditPopupForItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,4" Margin="2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Point & Print Policies & Diagnostics -->
            <TabItem Header="Point &amp; Print Policies &amp; Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <StackPanel Margin="0,8,0,16">
                        <!-- One-Click Batch Printer Remediation Card -->
                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="One-Click Batch Printer Remediation" Style="{StaticResource FluentSectionTitleStyle}" />
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Remediate All (Client + Server)"
                                            Command="{Binding RemediateAllPrintersCommand}"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            Padding="14,7" Margin="0,0,8,6" />
                                    <Button Content="Client Fix Batch"
                                            Command="{Binding RemediateClientBatchCommand}"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Padding="12,7" Margin="0,0,8,6" />
                                    <Button Content="Server Fix Batch"
                                            Command="{Binding RemediateServerBatchCommand}"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Padding="12,7" Margin="0,0,8,6" />
                                    <Button Content="Audit Point &amp; Print Policy"
                                            Command="{Binding AuditPointAndPrintPolicyCommand}"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Padding="12,7" Margin="0,0,8,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Point &amp; Print Policy, Error Codes &amp; Port Diagnostics" Style="{StaticResource FluentSectionTitleStyle}" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Preset -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Point &amp; Print Preset:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailablePresets}"
                                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
                                    <Button Grid.Row="0" Grid.Column="3" Content="Apply Policy Preset"
                                            Command="{Binding ApplyPointAndPrintCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,6" />

                                    <!-- Error Code -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Printer Error Code:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SupportedErrorCodes}"
                                              SelectedItem="{Binding SelectedErrorCode, Mode=TwoWay}" />
                                    <Button Grid.Row="2" Grid.Column="3" Content="Remediate Error Code"
                                            Command="{Binding RemediatePrinterErrorCommand}" IsEnabled="{Binding IsNotBusy}"
                                            Style="{DynamicResource AccentButtonStyle}" Padding="14,6" />

                                    <!-- Port Diagnostics -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Printer Host / IP:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding PrinterDiagnosticsHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" />
                                    <Button Grid.Row="4" Grid.Column="3" Content="Diagnose Printer Ports"
                                            Command="{Binding DiagnosePrinterHostCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,6" />
                                </Grid>

                                <TextBlock Text="{Binding LastPrinterStatus, StringFormat='Diagnostics: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Per-Adapter Modal Popup Overlay -->
        <Border Background="#B30F172A"
                Visibility="{Binding IsAdapterEditPopupOpen, Converter={StaticResource BoolToVisConverter}}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Border Style="{StaticResource FluentCardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- Popup Header -->
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Close Popup"
                                    Command="{Binding CloseAdapterEditPopupCommand}"
                                    Padding="12,5" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Manage Network Adapter (Per-Adapter Operations)" Style="{StaticResource FluentSectionTitleStyle}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding EditingAdapterHeaderSummary}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                            </StackPanel>
                        </DockPanel>

                        <!-- IPv4 Addressing -->
                        <TextBlock Text="IPv4 Addressing Configuration" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                        <CheckBox Content="Obtain an IP address automatically (DHCP)"
                                  IsChecked="{Binding AdapterUseDhcpIp, Mode=TwoWay}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Static IP Address:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding AdapterStaticIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2" Text="Subnet Mask:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="3" Text="{Binding AdapterSubnetMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Default Gateway:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding AdapterDefaultGateway, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="Save IP Configuration" Command="{Binding SaveAdapterIpConfigCommand}"
                                    IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" />
                        </Grid>

                        <!-- DNS Configuration -->
                        <TextBlock Text="DNS Server Configuration" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,6" />
                        <CheckBox Content="Obtain DNS server address automatically (DHCP)"
                                  IsChecked="{Binding AdapterUseDhcpDns, Mode=TwoWay}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Preferred DNS:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding AdapterPreferredDns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2" Text="Alternate DNS:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="3" Text="{Binding AdapterAlternateDns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                        </Grid>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Save DNS Configuration" Command="{Binding SaveAdapterDnsConfigCommand}"
                                    IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" />
                        </WrapPanel>

                        <!-- Advanced Adapter Controls -->
                        <TextBlock Text="Administrative State &amp; MTU" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,6" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MTU (Bytes):" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding AdapterMtu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="Set Adapter MTU" Command="{Binding SetAdapterMtuCommand}"
                                    IsEnabled="{Binding IsNotBusy}" Padding="12,5" />
                        </Grid>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Toggle Enable / Disable" Command="{Binding ToggleAdapterEnableCommand}"
                                    IsEnabled="{Binding IsNotBusy}" Padding="14,6" Margin="0,0,8,6" />
                            <Button Content="Renew Adapter DHCP" Command="{Binding RenewAdapterDhcpCommand}"
                                    IsEnabled="{Binding IsNotBusy}" Padding="14,6" Margin="0,0,8,6" />
                            <Button Content="Restart Adapter" Command="{Binding RestartAdapterCommand}"
                                    IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Margin="0,0,8,6" />
                        </WrapPanel>

                        <TextBlock Text="{Binding LastNetworkStatus, StringFormat='Operation Status: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- Per-Printer Modal Popup Overlay -->
        <Border Background="#B30F172A"
                Visibility="{Binding IsPrinterEditPopupOpen, Converter={StaticResource BoolToVisConverter}}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Border Style="{StaticResource FluentCardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- Popup Header -->
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Close Popup"
                                    Command="{Binding ClosePrinterEditPopupCommand}"
                                    Padding="12,5" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Manage Printer &amp; Spooler Operations" Style="{StaticResource FluentSectionTitleStyle}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding EditingPrinterHeaderSummary}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Per-Printer Operations -->
                        <TextBlock Text="Per-Printer Targeted Operations" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,8" />
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Print Test Page" Command="{Binding PrintTestPageCommand}"
                                    IsEnabled="{Binding IsNotBusy}" Style="{DynamicResource AccentButtonStyle}"
                                    Padding="14,7" Margin="0,0,8,6" />
                            <Button Content="Purge Printer Queue" Command="{Binding PurgeTargetPrinterQueueCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Padding="14,7" Margin="0,0,8,6" />
                            <Button Content="Set as Default Printer" Command="{Binding SetAsDefaultPrinterCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Padding="14,7" Margin="0,0,8,6" />
                            <Button Content="Reset Network Connection" Command="{Binding ResetTargetPrinterConnectionCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Padding="14,7" Margin="0,0,8,6" />
                        </WrapPanel>

                        <TextBlock Text="{Binding LastPrinterStatus, StringFormat='Printer Operation Status: {0}'}" Style="{StaticResource FluentCaptionStyle}" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
