<Window x:Class="IToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
        xmlns:views="clr-namespace:IToolkit.App.Views"
        xmlns:converters="clr-namespace:IToolkit.App.Converters"
        mc:Ignorable="d"
        Title="iToolKit"
        Icon="pack://application:,,,/iToolKit;component/Assets/iToolKit.ico"
        Height="560" Width="900"
        MinHeight="480" MinWidth="780"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- DataTemplates for Pillar Navigation -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemHealthViewModel}">
            <views:SystemHealthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OfficeOutlookViewModel}">
            <views:OfficeOutlookView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectivityViewModel}">
            <views:ConnectivityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IdentityBackupViewModel}">
            <views:IdentityBackupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SoftwareOptimizationViewModel}">
            <views:SoftwareOptimizationView />
        </DataTemplate>

        <!-- Compact Fluent NavRail Item Style -->
        <Style x:Key="NavRailItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ActiveIndicator"
                                    Width="3"
                                    Height="14"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Compact System Telemetry Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Workspace (Left Slim Nav Rail + Active Page) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: System Telemetry Status Header -->
        <views:TelemetryHeaderView Grid.Row="0" DataContext="{Binding TelemetryHeader}" />

        <!-- Row 1: Navigation Rail + Page Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Slim Navigation Rail -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="6,8">
                <DockPanel LastChildFill="True">
                    <!-- Brand Header -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,6,8">
                        <Border Width="24" Height="24" CornerRadius="4"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="M14.7,6.3 C15.1,5.9 15.1,5.3 14.7,4.9 L13.1,3.3 C12.7,2.9 12.1,2.9 11.7,3.3 L9.6,5.4 L3,12 L3,15 L6,15 L12.6,8.4 L14.7,6.3 Z"
                                  Fill="#FFFFFF" Stretch="Uniform" Width="12" Height="12"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="iToolKit" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Navigation Items (Single-line icon + label) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <RadioButton GroupName="PillarNav" Style="{StaticResource NavRailItemStyle}"
                                         IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M14,14 L21,14 L21,21 L14,21 Z M3,14 L10,14 L10,21 L3,21 Z"
                                          Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                          Stretch="Uniform" Width="14" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Dashboard" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <Separator Margin="4,4" />

                            <RadioButton GroupName="PillarNav" Style="{StaticResource NavRailItemStyle}"
                                         Command="{Binding NavigateCommand}" CommandParameter="SystemHealth">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M12,2 L4,5.5 L4,11.5 C4,16.8 7.4,21.6 12,23 C16.6,21.6 20,16.8 20,11.5 L20,5.5 L12,2 Z"
                                          Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                          Stretch="Uniform" Width="14" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="System Health" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="PillarNav" Style="{StaticResource NavRailItemStyle}"
                                         Command="{Binding NavigateCommand}" CommandParameter="OfficeOutlook">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M2,5 C2,3.9 2.9,3 4,3 L20,3 C21.1,3 22,3.9 22,5 L22,19 C22,20.1 21.1,21 20,21 L4,21 C2.9,21 2,20.1 2,19 L2,5 Z M4,6.5 L12,12 L20,6.5 L20,5 L12,10.5 L4,5 L4,6.5 Z"
                                          Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                          Stretch="Uniform" Width="14" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Office &amp; Outlook" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="PillarNav" Style="{StaticResource NavRailItemStyle}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Connectivity">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M6,3 L18,3 L18,8 L6,8 Z M4,9 L20,9 C21.1,9 22,9.9 22,11 L22,17 L18,17 L18,21 L6,21 L6,17 L2,17 L2,11 C2,9.9 2.9,9 4,9 Z M8,14 L8,19 L16,19 L16,14 Z"
                                          Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                          Stretch="Uniform" Width="14" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Network &amp; Printers" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="PillarNav" Style="{StaticResource NavRailItemStyle}"
                                         Command="{Binding NavigateCommand}" CommandParameter="IdentityBackup">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M12,4 C14.2,4 16,5.8 16,8 C16,10.2 14.2,12 12,12 C9.8,12 8,10.2 8,8 C8,5.8 9.8,4 12,4 Z M12,14 C16.4,14 20,16.2 20,19 L20,21 L4,21 L4,19 C4,16.2 7.6,14 12,14 Z"
                                          Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                          Stretch="Uniform" Width="14" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Identity &amp; Backup" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="PillarNav" Style="{StaticResource NavRailItemStyle}"
                                         Command="{Binding NavigateCommand}" CommandParameter="SoftwareOptimization">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 L12,2 Z M12,4.3 L5.5,7.9 L12,11.5 L18.5,7.9 L12,4.3 Z"
                                          Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                          Stretch="Uniform" Width="14" Height="14" Margin="2,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Apps &amp; Optimization" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Active Content Area + System Scan Progress Banner -->
            <DockPanel Grid.Column="1" LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="10,4"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="System Scan:" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding ScanStatusText}" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        <ProgressBar Grid.Column="2" Minimum="0" Maximum="100"
                                     Value="{Binding ScanProgressPercentage, Mode=OneWay}" Height="4"
                                     VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding ScanProgressText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ContentControl Content="{Binding CurrentPageViewModel}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
