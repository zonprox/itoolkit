<UserControl x:Class="IToolkit.App.Views.ActivityConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             xmlns:models="clr-namespace:IToolkit.Core.Models;assembly=IToolkit.Core"
             xmlns:converters="clr-namespace:IToolkit.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ActivityConsoleViewModel}"
             Height="{Binding ConsoleHeight}"
             MinHeight="30"
             MaxHeight="480">
    <UserControl.Resources>
        <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Compact Console Toolbar -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Entry Count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Activity Log" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <Border CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} entries'}" FontSize="10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Execution Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{Binding ExecutionStatusBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ExecutionStatus}" FontSize="11" FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Search & Level Filter -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="130" Height="22" Padding="4,1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" VerticalContentAlignment="Center"
                             ToolTip="Filter logs by keyword or component" />
                    <ComboBox Width="80" Height="22" Margin="4,0,0,0"
                              SelectedValue="{Binding SelectedLevelFilter}"
                              SelectedValuePath="Content" FontSize="11">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="Info" />
                        <ComboBoxItem Content="Success" />
                        <ComboBoxItem Content="Warning" />
                        <ComboBoxItem Content="Error" />
                    </ComboBox>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Auto-Scroll" IsChecked="{Binding AutoScroll}"
                              VerticalAlignment="Center" Margin="2,0,8,0" FontSize="11" />
                    <Button Command="{Binding CopyLogCommand}" Content="Copy" Height="22" Padding="8,2" Margin="0,0,4,0" FontSize="11" />
                    <Button Command="{Binding ClearLogCommand}" Content="Clear" Height="22" Padding="8,2" Margin="0,0,4,0" FontSize="11" />
                    <Button Command="{Binding ToggleExpandedCommand}" Content="Toggle" Height="22" Padding="8,2" FontSize="11"
                            ToolTip="Expand or collapse Activity Log" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Operation Completion Banner -->
        <Border Grid.Row="1" Background="{Binding CompletionBannerBrush}" Padding="10,4"
                Visibility="{Binding ShowCompletionBanner, Converter={StaticResource BoolToVisConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding DismissCompletionCommand}"
                        Content="Dismiss" Height="22" Padding="8,2" Margin="8,0,0,0" FontSize="11" />
                <TextBlock Text="{Binding CompletionMessage}" FontSize="11" FontWeight="SemiBold"
                           Foreground="#FFFFFF" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Row 2: Log Stream -->
        <ListBox x:Name="LogListBox" Grid.Row="2" ItemsSource="{Binding FilteredEntries}"
                 BorderThickness="0" Padding="6,2"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ActivityLogEntry}">
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                        <Border Grid.Column="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}, ConverterParameter='Background'}">
                            <TextBlock Text="{Binding Level}" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}, ConverterParameter='Foreground'}" />
                        </Border>

                        <TextBlock Grid.Column="2" Text="{Binding Component, StringFormat='[{0}]'}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="4,0" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="3" Text="{Binding Message}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
