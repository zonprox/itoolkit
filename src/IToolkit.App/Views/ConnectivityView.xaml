<UserControl x:Class="IToolkit.App.Views.ConnectivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IToolkit.App.ViewModels"
             xmlns:converters="clr-namespace:IToolkit.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:ConnectivityViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <!-- Header -->
            <TextBlock Text="Connectivity &amp; Printer Subsystem" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
            <TextBlock Text="One-click network remediation, SMB guest auth, Print Spooler repair, and Point &amp; Print policy fixes." FontSize="13" Foreground="#AAAAAA" Margin="0,0,0,20"/>

            <!-- Execution Status Banner -->
            <Border Background="#252528" CornerRadius="6" Padding="14" Margin="0,0,0,16" BorderBrush="#3A3A3E" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Current Operation Status" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                        <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}" FontSize="13" FontWeight="Medium" Foreground="#E0E0E0" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsBusy}" Width="120" Height="6" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                </Grid>
            </Border>

            <!-- Card 1: One-Click Network Stack Remediation -->
            <Border Background="#1E1E20" CornerRadius="8" Padding="18" Margin="0,0,0,16" BorderBrush="#2E2E32" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="1. Network Stack Remediation" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <TextBlock Text="Flushes DNS, renews DHCP lease, purges ARP cache, and resets Winsock catalog and TCP/IP stack." FontSize="12" Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Remediate Entire Network Stack" Command="{Binding RemediateNetworkStackCommand}" IsEnabled="{Binding IsNotBusy}" Padding="16,8" Background="#0067C0" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,10,8"/>
                        <Button Content="Flush DNS Cache" Command="{Binding FlushDnsCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                        <Button Content="Renew DHCP Lease" Command="{Binding RenewDhcpCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                        <Button Content="Clear ARP Cache" Command="{Binding ClearArpCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                        <Button Content="Reset Winsock" Command="{Binding ResetWinsockCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                        <Button Content="Reset TCP/IP" Command="{Binding ResetTcpIpCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                    </WrapPanel>

                    <TextBlock Text="{Binding LastNetworkStatus, StringFormat='Network Status: {0}'}" FontSize="12" Foreground="#CCCCCC"/>
                </StackPanel>
            </Border>

            <!-- Card 2: SMB & Sharing Configuration -->
            <Border Background="#1E1E20" CornerRadius="8" Padding="18" Margin="0,0,0,16" BorderBrush="#2E2E32" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="2. SMB Sharing &amp; Insecure Guest Authentication" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <TextBlock Text="Enables InsecureGuestAuth=1, configures firewall rules for File and Printer Sharing, and starts required Lanman services." FontSize="12" Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Configure SMB Sharing &amp; Insecure Guest Auth" Command="{Binding ConfigureSmbSharingCommand}" IsEnabled="{Binding IsNotBusy}" Padding="16,8" Background="#2D2D30" Foreground="#FFFFFF"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: Print Spooler Subsystem -->
            <Border Background="#1E1E20" CornerRadius="8" Padding="18" Margin="0,0,0,16" BorderBrush="#2E2E32" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="3. Print Spooler Subsystem Repair" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <TextBlock Text="Purges stuck printer queue spool files, re-registers spooler components, and resets virtual NeXX: port bindings." FontSize="12" Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Purge Spooler Queue" Command="{Binding PurgeSpoolerCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#0067C0" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                        <Button Content="Re-Register Spooler DLLs &amp; MOF" Command="{Binding RegisterSpoolerCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                        <Button Content="Reset NeXX: Port Bindings" Command="{Binding ResetNePortsCommand}" IsEnabled="{Binding IsNotBusy}" Padding="14,8" Background="#2D2D30" Foreground="#FFFFFF" Margin="0,0,10,8"/>
                    </WrapPanel>

                    <TextBlock Text="{Binding LastPrinterStatus, StringFormat='Printer Status: {0}'}" FontSize="12" Foreground="#CCCCCC"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Point & Print & Error Code Remediation -->
            <Border Background="#1E1E20" CornerRadius="8" Padding="18" Margin="0,0,0,16" BorderBrush="#2E2E32" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="4. Point &amp; Print Policy &amp; Error Code Remediation" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <TextBlock Text="Resolve Point &amp; Print RPC errors (e.g., 0x0000011b, 0x00000709) and perform printer network port diagnostics." FontSize="12" Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Point &amp; Print Preset:" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" Width="180" Margin="0,0,12,0"/>
                        <Button Content="Apply Point &amp; Print Policy" Command="{Binding ApplyPointAndPrintCommand}" IsEnabled="{Binding IsNotBusy}" Padding="12,6" Background="#2D2D30" Foreground="#FFFFFF"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Remediate Specific Error Code:" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding SupportedErrorCodes}" SelectedItem="{Binding SelectedErrorCode, Mode=TwoWay}" Width="160" Margin="0,0,12,0"/>
                        <Button Content="Remediate Selected Error" Command="{Binding RemediatePrinterErrorCommand}" IsEnabled="{Binding IsNotBusy}" Padding="12,6" Background="#0067C0" Foreground="#FFFFFF"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Printer Host IP / Name:" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding PrinterDiagnosticsHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160" Background="#252528" Foreground="#FFFFFF" BorderBrush="#3A3A3E" Padding="6,4" Margin="0,0,12,0"/>
                        <Button Content="Diagnose Printer Ports" Command="{Binding DiagnosePrinterHostCommand}" IsEnabled="{Binding IsNotBusy}" Padding="12,6" Background="#2D2D30" Foreground="#FFFFFF"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
